# ── 小七 · 环境变量示例（复制为 .env 使用，勿提交真实密钥） ──

# LLM（对话核心）
XIAOQI_LLM_API_KEY=
# XIAOQI_LLM_BASE_URL=https://api.deepseek.com
# XIAOQI_LLM_MODEL=deepseek-v4-flash

# Web 服务
# XIAOQI_WEB_HOST=0.0.0.0
# XIAOQI_WEB_PORT=8000
# XIAOQI_SIM_MINUTES_PER_REAL_SECOND=60

# ── 语音（Voice） ──
# STT 提供方：faster-whisper（本地）｜留空则前端用浏览器 Web Speech API
STT_PROVIDER=faster-whisper

# TTS 提供方：alibaba（云端 Qwen3-TTS）｜browser（开发 fallback）
XIAOQI_TTS_PROVIDER=alibaba

# ── 阿里云 Model Studio（百炼）Qwen3-TTS ──
# API Key（只由后端读取，绝不写入 JS / Git / README）
XIAOQI_ALIBABA_API_KEY=
# 模型：qwen3-tts-flash（非实时）/ qwen3-tts-instruct-flash（指令控制）
XIAOQI_ALIBABA_MODEL=qwen3-tts-flash
# Voice ID：用「声音克隆」工具创建后填入（见 voice.profiles.xiaoqi）
XIAOQI_ALIBABA_VOICE_ID=
# 区域：singapore（默认，新加坡）/ beijing（北京）
XIAOQI_ALIBABA_REGION=singapore
# 语种：Chinese（官方值）/ English / Japanese ...
XIAOQI_ALIBABA_LANGUAGE=Chinese
# 请求超时（秒）
# XIAOQI_ALIBABA_TIMEOUT=30

# faster-whisper 模型大小（base / small / medium / large-v3）
XIAOQI_STT_MODEL=base
